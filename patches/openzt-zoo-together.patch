+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn frames_round_trip() {
+        let msgs = [
+            Msg::Hello { protocol: PROTOCOL_VERSION, role: ROLE_CLIENT },
+            Msg::CashState { seq: 7, cash: 12345.5, acked_spend: 3 },
+            Msg::Spend { seq: 9, amount: 250.0 },
+            Msg::Keepalive,
+        ];
+        for m in msgs {
+            let bytes = m.encode();
+            let len = u32::from_le_bytes(bytes[0..4].try_into().unwrap()) as usize;
+            assert_eq!(len, bytes.len() - 4);
+            assert_eq!(Msg::decode(&bytes[4..]), Some(m));
+        }
+    }
+
+    #[test]
+    fn decode_rejects_bad_frames() {
+        assert_eq!(Msg::decode(&[]), None);
+        assert_eq!(Msg::decode(&[99]), None);
+        assert_eq!(Msg::decode(&[T_CASH, 1, 2, 3]), None);
+        assert_eq!(Msg::decode(&[T_KEEPALIVE, 0]), None);
+    }
+
+    #[test]
+    fn client_ledger_hides_unacked_spends() {
+        let mut c = ClientLedger::default();
+        let a = c.record_spend(100.0);
+        let _b = c.record_spend(50.0);
+        // Snapshot from before either spend reached the host.
+        assert_eq!(c.apply_snapshot(1000.0, 0), 850.0);
+        // Host applied the first spend.
+        assert_eq!(c.apply_snapshot(900.0, a), 850.0);
+        assert_eq!(c.pending(), 1);
+        assert_eq!(c.apply_snapshot(850.0, a + 1), 850.0);
+        assert_eq!(c.pending(), 0);
+    }
+
+    #[test]
+    fn host_ledger_applies_each_spend_once() {
+        let mut h = HostLedger::default();
+        assert_eq!(h.accept(1, 10.0), Some(10.0));
+        assert_eq!(h.accept(1, 10.0), None);
+        assert_eq!(h.accept(2, f32::NAN), None);
+        assert_eq!(h.accept(3, 5.0), Some(5.0));
+    }
+
+    #[test]
+    fn tcp_link_carries_frames() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let addr = listener.local_addr().unwrap();
+        let (tx, rx) = mpsc::channel();
+        let client = TcpStream::connect(addr).unwrap();
+        let (server, _) = listener.accept().unwrap();
+        let _link = spawn_link(client, tx, ROLE_CLIENT).unwrap();
+        let mut server = server;
+        assert_eq!(read_frame(&mut server).unwrap(), Msg::Hello { protocol: PROTOCOL_VERSION, role: ROLE_CLIENT });
+        server.write_all(&Msg::CashState { seq: 1, cash: 42.0, acked_spend: 0 }.encode()).unwrap();
+        let mut got = None;
+        for _ in 0..3 {
+            if let Ok(NetEvent::Msg(m)) = rx.recv_timeout(Duration::from_secs(2)) {
+                got = Some(m);
+                break;
+            }
+        }
+        assert_eq!(got, Some(Msg::CashState { seq: 1, cash: 42.0, acked_spend: 0 }));
+    }
+}
