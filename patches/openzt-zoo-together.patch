+/// Adds `days` to a raw `SYSTEMTIME` (via `FILETIME`, 100 ns ticks).
+fn shift_systemtime(bytes: [u8; 16], days: i32) -> Option<[u8; 16]> {
+    use windows::Win32::{
+        Foundation::{FILETIME, SYSTEMTIME},
+        System::Time::{FileTimeToSystemTime, SystemTimeToFileTime},
+    };
+    let st: SYSTEMTIME = unsafe { std::mem::transmute(bytes) };
+    let mut ft = FILETIME::default();
+    unsafe { SystemTimeToFileTime(&st, &mut ft) }.ok()?;
+    let ticks = ((ft.dwHighDateTime as i64) << 32 | ft.dwLowDateTime as i64) + days as i64 * 864_000_000_000;
+    let ft = FILETIME { dwLowDateTime: ticks as u32, dwHighDateTime: (ticks >> 32) as u32 };
+    let mut out = SYSTEMTIME::default();
+    unsafe { FileTimeToSystemTime(&ft, &mut out) }.ok()?;
+    Some(unsafe { std::mem::transmute::<SYSTEMTIME, [u8; 16]>(out) })
+}
