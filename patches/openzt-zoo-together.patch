+/// Client-side pause: a local toggle becomes a request; host state wins once the request is acked.
+#[derive(Debug, Default)]
+pub struct PauseSync {
+    next_seq: u32,
+    pending: Option<u32>,
+    /// The pause state the client last saw from the host (or set itself from the host).
+    applied: bool,
+}
+
+pub enum PauseAction {
+    None,
+    /// Tell the host the client toggled pause.
+    Request { seq: u32, paused: bool },
+    /// Make the local game match the host.
+    Apply(bool),
+}
+
+impl PauseSync {
+    /// Called every client tick with the local pause flag.
+    pub fn on_local(&mut self, local: bool) -> PauseAction {
+        if self.pending.is_none() && local != self.applied {
+            self.next_seq += 1;
+            self.pending = Some(self.next_seq);
+            self.applied = local;
+            return PauseAction::Request { seq: self.next_seq, paused: local };
+        }
+        PauseAction::None
+    }
+
+    /// Called for each host snapshot.
+    pub fn on_host(&mut self, host_paused: bool, acked: u32, local: bool) -> PauseAction {
+        if self.pending.is_some_and(|s| acked >= s) {
+            self.pending = None;
+        }
+        // Waiting for the host to ack our request, or a local toggle [`Self::on_local`] hasn't sent yet:
+        // the snapshot is older than the player's choice, so it must not undo it.
+        if self.pending.is_some() || local != self.applied {
+            return PauseAction::None;
+        }
+        self.applied = host_paused;
+        if host_paused != local { PauseAction::Apply(host_paused) } else { PauseAction::None }
+    }
+}
