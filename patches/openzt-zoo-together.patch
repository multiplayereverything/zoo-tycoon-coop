+// --- player cursors -------------------------------------------------------------------------
+//
+// Geometry (from `ZTMapView::setViewCenter` 0x59b90c and `BFMap` conversions):
+// - `ZTMapView+0x360` is the `BFMap`; `BFMap+0x14/+0x18` is the camera origin in "virtual" pixels
+//   (the projected screen plane at the current zoom/rotation); `ZTMapView+0x4c/+0x50` is the view size.
+// - view-local pixel = virtual - origin; `BFMap::virtualToWorld(out, in)` / `worldToVirtual(out, in)`
+//   convert between virtual and world (3 x i32).
+// - `UIElement::getScreenPos` gives the map view's top-left in the window's client area.
+
+#[link(name = "user32")]
+unsafe extern "system" {
+    fn GetCursorPos(p: *mut [i32; 2]) -> i32;
+    fn ScreenToClient(hwnd: isize, p: *mut [i32; 2]) -> i32;
+    fn EnumThreadWindows(thread: u32, f: unsafe extern "system" fn(isize, isize) -> i32, l: isize) -> i32;
+    fn IsWindowVisible(hwnd: isize) -> i32;
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn GetCurrentThreadId() -> u32;
+}
+#[link(name = "gdi32")]
+unsafe extern "system" {
+    fn CreatePen(style: i32, width: i32, color: u32) -> isize;
+    fn SelectObject(hdc: isize, obj: isize) -> isize;
+    fn DeleteObject(obj: isize) -> i32;
+    fn GetStockObject(i: i32) -> isize;
+    fn Ellipse(hdc: isize, l: i32, t: i32, r: i32, b: i32) -> i32;
+    fn MoveToEx(hdc: isize, x: i32, y: i32, old: *mut [i32; 2]) -> i32;
+    fn LineTo(hdc: isize, x: i32, y: i32) -> i32;
+    fn SetBkMode(hdc: isize, mode: i32) -> i32;
+    fn SetTextColor(hdc: isize, color: u32) -> u32;
+    fn TextOutA(hdc: isize, x: i32, y: i32, s: *const u8, n: i32) -> i32;
+}
+
+static CURSORS_DRAWN: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+/// Lab: a fake mouse position in the window's client area (the lab can't move the real mouse).
+static TEST_CURSOR: Mutex<Option<(i32, i32)>> = Mutex::new(None);
+
+fn fmt_vec(v: Option<[i32; 3]>) -> String {
+    v.map(|[x, y, z]| format!("{x},{y},{z}")).unwrap_or_else(|| "none".into())
+}
+
+struct MapView {
+    view: *const u32,
+    map: *const u32,
+}
+
+impl MapView {
+    fn get() -> Option<MapView> {
+        use openzt_detour::generated::ztui_general::GET_MAPVIEW;
+        if !in_game() {
+            return None;
+        }
+        let view = unsafe { GET_MAPVIEW.original()() };
+        if view.is_null() {
+            return None;
+        }
+        let map = unsafe { *((view as u32 + 0x360) as *const *const u32) };
+        (!map.is_null()).then_some(MapView { view, map })
+    }
+
+    fn field(&self, base: *const u32, off: u32) -> i32 {
+        unsafe { *((base as u32 + off) as *const i32) }
+    }
+
+    /// Top-left of the map view in client pixels, and its size.
+    fn rect(&self) -> (i32, i32, i32, i32) {
+        use openzt_detour::generated::uielement::GET_SCREEN_POS;
+        let mut pos = [0i32; 2];
+        unsafe { GET_SCREEN_POS.original()(self.view, pos.as_mut_ptr()) };
+        (pos[0], pos[1], self.field(self.view, 0x4c), self.field(self.view, 0x50))
+    }
+
+    fn origin(&self) -> (i32, i32) {
+        (self.field(self.map, 0x14), self.field(self.map, 0x18))
+    }
+}
+
+/// Client-area pixel → world position, if the pixel is over the map view.
+fn screen_to_world(px: i32, py: i32) -> Option<[i32; 3]> {
+    use openzt_detour::generated::bfmap::VIRTUAL_TO_WORLD;
+    let mv = MapView::get()?;
+    let (sx, sy, w, h) = mv.rect();
+    let (lx, ly) = (px - sx, py - sy);
+    if lx < 0 || ly < 0 || lx >= w || ly >= h {
+        return None;
+    }
+    let (ox, oy) = mv.origin();
+    let virt = [ox + lx, oy + ly, 0];
+    let mut world = [0i32; 3];
+    // (this, out, in): the input is read from the second argument (0x4441e4).
+    unsafe { VIRTUAL_TO_WORLD.original()(mv.map, world.as_mut_ptr() as *const u32, virt.as_ptr()) };
+    Some(world)
+}
+
+/// World position → client-area pixel (may be off-screen).
+fn world_to_screen(world: [i32; 3]) -> Option<(i32, i32)> {
+    use openzt_detour::generated::bfmap::WORLD_TO_VIRTUAL_0;
+    let mv = MapView::get()?;
+    let (sx, sy, _, _) = mv.rect();
+    let (ox, oy) = mv.origin();
+    let mut virt = [0i32; 3];
+    unsafe { WORLD_TO_VIRTUAL_0.original()(mv.map, virt.as_mut_ptr(), world.as_ptr()) };
+    Some((virt[0] - ox + sx, virt[1] - oy + sy))
+}
+
+static GAME_HWND: std::sync::atomic::AtomicIsize = std::sync::atomic::AtomicIsize::new(0);
+
+/// The game's visible top-level window (looked up once, from the game thread).
+fn game_hwnd() -> isize {
+    unsafe extern "system" fn first_visible(hwnd: isize, _: isize) -> i32 {
+        if unsafe { IsWindowVisible(hwnd) } != 0 {
+            GAME_HWND.store(hwnd, Ordering::Relaxed);
+            return 0;
+        }
+        1
+    }
+    if GAME_HWND.load(Ordering::Relaxed) == 0 {
+        unsafe { EnumThreadWindows(GetCurrentThreadId(), first_visible, 0) };
+    }
+    GAME_HWND.load(Ordering::Relaxed)
+}
+
+/// This player's mouse over the map, in world units.
+fn local_cursor_world() -> Option<[i32; 3]> {
+    let (px, py) = match *TEST_CURSOR.lock().unwrap() {
+        Some(p) => p,
+        None => {
+            let hwnd = game_hwnd();
+            let mut p = [0i32; 2];
+            if hwnd == 0 || unsafe { GetCursorPos(&mut p) } == 0 || unsafe { ScreenToClient(hwnd, &mut p) } == 0 {
+                return None;
+            }
+            (p[0], p[1])
+        }
+    };
+    screen_to_world(px, py)
