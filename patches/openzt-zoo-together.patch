+// Removal: selling or bulldozing ends in `ZTMapView::removeEntityFromMap(entity, refund, ...)`
+// (0x50a0b0; callers: `ZTMapView::removeEntity` 0x50a432, which the sell button reaches through
+// `removeSelectedEntity` 0x48d065, plus 0x485b41 and 0x4efd12). [`removal_detours`] reports the entity
+// before it goes; [`remove_entity`] finds the same object on the other copy (type and position) and
+// calls `removeEntity`, which refunds that copy. A client's own refund is overwritten by the host's
+// budget, so only the host's refund counts.
+//
+// Selling a building asks "are you sure?" inside `removeEntityFromMap` (0x50bf8d, a modal yes/no
+// through `BFUIMgr` 0x4fff2c that runs nested game frames until answered); it only asks when the map
+// view's byte `+0x456` is set. So the hook reports a removal only once the object is really gone (the
+// player may answer no), and the replay clears that byte so the other player gets no dialog.
+
+static PENDING_REMOVED: Mutex<Vec<Placement>> = Mutex::new(Vec::new());
+static LAST_REMOVED: Mutex<Option<Placement>> = Mutex::new(None);
+
+#[detour_mod]
+mod removal_detours {
+    use openzt_detour::generated::ztmapview::REMOVE_ENTITY_FROM_MAP;
+
+    #[detour(REMOVE_ENTITY_FROM_MAP)]
+    unsafe extern "thiscall" fn remove_entity_from_map(mapview: *const u32, entity: *const i32, refund: f32, a: i8, b: *const i32, c: i8) {
+        let before = super::removal_candidate(entity as u32);
+        unsafe { REMOVE_ENTITY_FROM_MAP_DETOUR.call(mapview, entity, refund, a, b, c) };
+        if let Some(pl) = before {
+            super::on_entity_removed(entity as u32, pl);
+        }
+    }
+}
+
+/// The object about to be removed, if it is one this mod syncs (placed, non-moving: not animals,
+/// guests or staff) and the player is removing it (not a replay).
+fn removal_candidate(entity: u32) -> Option<Placement> {
+    if entity == 0 || APPLYING_REMOTE.load(Ordering::Relaxed) || !crate::ztworldmgr::coop_static_entities().contains(&entity) {
+        return None;
+    }
+    placement_of(entity)
+}
+
+/// Called (game thread) after `removeEntityFromMap` returned for a [`removal_candidate`].
+fn on_entity_removed(entity: u32, pl: Placement) {
+    if crate::ztworldmgr::coop_static_entities().contains(&entity) {
+        return; // still there: the player answered no
+    }
+    info!("coop: removed {}", fmt_placement(&pl));
+    *LAST_REMOVED.lock().unwrap() = Some(pl.clone());
+    PENDING_REMOVED.lock().unwrap().push(pl);
+}
+
+/// Runs `f` with the map view's "confirm before selling" byte cleared (see the removal notes above).
+fn without_sell_confirm(mapview: *const u32, f: impl FnOnce()) {
+    let flag = (mapview as u32 + 0x456) as *mut u8;
+    unsafe {
+        let old = *flag;
+        *flag = 0;
+        f();
+        *flag = old;
+    }
+}
+
+/// Removes the object matching `pl` (type and position) from this copy, the way the sell button does.
+fn remove_entity(pl: &Placement) -> Result<(), String> {
+    use openzt_detour::generated::ztmapview::{REMOVE_ENTITY, SET_SELECTED_ENTITY_0};
+    use openzt_detour::generated::ztui_general::GET_MAPVIEW;
+    let entity = crate::ztworldmgr::coop_static_entities()
+        .into_iter()
+        .find(|&e| placement_of(e).is_some_and(|p| p.zt_type == pl.zt_type && p.zt_sub_type == pl.zt_sub_type && p.pos == pl.pos))
+        .ok_or_else(|| format!("nothing to remove at {}", fmt_placement(pl)))?;
+    let mapview = unsafe { GET_MAPVIEW.original()() };
+    if mapview.is_null() {
+        return Err("no map view".into());
+    }
+    unsafe {
+        // Like `removeSelectedEntity`: deselect first if this player has it selected.
+        if *((mapview as u32 + 0x438) as *const u32) == entity {
+            SET_SELECTED_ENTITY_0.original()(mapview, std::ptr::null(), true);
+        }
+        APPLYING_REMOTE.store(true, Ordering::Relaxed);
+        without_sell_confirm(mapview, || REMOVE_ENTITY.original()(mapview, entity as *const i32, 0));
+        APPLYING_REMOTE.store(false, Ordering::Relaxed);
+    }
+    Ok(())
+}
