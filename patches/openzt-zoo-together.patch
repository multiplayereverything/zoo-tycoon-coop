+    /// Adds a chunk; returns the whole file once every byte has arrived.
+    pub fn add(&mut self, offset: u32, total: u32, data: &[u8]) -> Option<Vec<u8>> {
+        if offset == 0 {
+            self.buf = vec![0u8; total as usize];
+            self.received = 0;
+        }
+        if self.buf.len() != total as usize {
+            return None;
+        }
+        let end = offset as usize + data.len();
+        self.buf.get_mut(offset as usize..end)?.copy_from_slice(data);
+        self.received += data.len() as u32;
+        (self.received == total).then(|| std::mem::take(&mut self.buf))
+    }
+}
