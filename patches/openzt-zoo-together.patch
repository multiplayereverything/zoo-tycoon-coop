+    let release_dc: unsafe extern "system" fn(*const usize, isize) -> i32 = unsafe { std::mem::transmute(*vtbl.add(26)) };
+    let mut hdc = 0isize;
+    if unsafe { get_dc(surface, &mut hdc) } < 0 || hdc == 0 {
+        return;
+    }
+    const COLOR: u32 = 0x00_00_ff_ff; // COLORREF 0x00BBGGRR: yellow
+    unsafe {
+        let pen = CreatePen(0, 2, COLOR);
+        let old_pen = SelectObject(hdc, pen);
+        let old_brush = SelectObject(hdc, GetStockObject(5)); // NULL_BRUSH
+        Ellipse(hdc, x - 9, y - 9, x + 10, y + 10);
+        MoveToEx(hdc, x - 14, y, std::ptr::null_mut());
+        LineTo(hdc, x + 15, y);
+        MoveToEx(hdc, x, y - 14, std::ptr::null_mut());
