+fn draw_remote_cursor(videomgr: *const i32) {
+    // try_lock: never block the render path on the session.
+    let Some(world) = SESSION.try_lock().ok().and_then(|g| g.as_ref().and_then(|s| s.remote_cursor)) else { return };
+    let Some((x, y)) = world_to_screen(world) else { return };
+    let surface = unsafe { *((videomgr as u32 + 0x20) as *const *const usize) };
+    if surface.is_null() {
+        return;
+    }
+    // IDirectDrawSurface vtable: GetDC at slot 17 (0x44), ReleaseDC at slot 26 (0x68).
+    let vtbl = unsafe { *surface as *const usize };
