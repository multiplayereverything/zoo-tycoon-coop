+// --- building -------------------------------------------------------------------------------
+//
+// A purchase: the buy menu puts a freshly created entity on the cursor (`ZTMapView::setTempEntity`)
+// and the map click calls `ZTMapView::placeEntityOnMap(entity, cost, 0)` (0x4d9088, called from the
+// left-button-up handler 0x4d871e), which returns the placed entity. openzt's `roofs.rs` detours that
+// function and calls [`on_entity_placed`]. To replay a placement, [`place_entity`] does the same:
+// `BFEntityType::create`, rotation at entity `+0x12c`, `setWorldPos` (x, y, z at `+0x114`),
+// `snapToGrid`, then `placeEntityOnMap` with no cost.
+
+static PENDING_PLACED: Mutex<Vec<Placement>> = Mutex::new(Vec::new());
+static LAST_PLACED: Mutex<Option<Placement>> = Mutex::new(None);
+/// Set while this copy replays a remote placement, so the hook doesn't send it back.
+static APPLYING_REMOTE: AtomicBool = AtomicBool::new(false);
+
+fn fmt_placement(p: &Placement) -> String {
+    format!("{}/{}@{},{},{}r{}", p.zt_type, p.zt_sub_type, p.pos[0], p.pos[1], p.pos[2], p.rotation)
+}
+
+fn read_i32(addr: u32) -> i32 {
+    unsafe { *(addr as *const i32) }
+}
+
+fn type_key(type_ptr: u32) -> (String, String) {
+    use crate::util::get_string_from_memory;
+    (get_string_from_memory(read_i32(type_ptr + 0x98) as u32), get_string_from_memory(read_i32(type_ptr + 0xa4) as u32))
+}
+
+/// Called (game thread) after the player placed an object on this copy.
+pub fn on_entity_placed(entity: u32) {
+    if APPLYING_REMOTE.load(Ordering::Relaxed) {
+        return;
+    }
+    let type_ptr = read_i32(entity + 0x128) as u32;
+    if type_ptr == 0 {
+        return;
+    }
+    let (zt_type, zt_sub_type) = type_key(type_ptr);
+    let pl = Placement {
+        zt_type,
+        zt_sub_type,
+        pos: [read_i32(entity + 0x114), read_i32(entity + 0x118), read_i32(entity + 0x11c)],
+        rotation: read_i32(entity + 0x12c),
+    };
+    info!("coop: placed {}", fmt_placement(&pl));
+    *LAST_PLACED.lock().unwrap() = Some(pl.clone());
+    PENDING_PLACED.lock().unwrap().push(pl);
+}
+
+/// Builds `pl` on this copy the way a purchase does (no cost: the buyer's copy already paid).
+fn place_entity(pl: &Placement) -> Result<u32, String> {
+    use openzt_detour::generated::{
+        bfentity::{SET_WORLD_POS, SNAP_TO_GRID}, bfoverlaytype::CREATE as BFENTITYTYPE_CREATE, ztmapview::PLACE_ENTITY_ON_MAP_1,
+        ztui_general::GET_MAPVIEW,
+    };
+    let type_ptr = crate::ztworldmgr::coop_entity_types()
+        .into_iter()
+        .find(|&t| type_key(t) == (pl.zt_type.clone(), pl.zt_sub_type.clone()))
+        .ok_or_else(|| format!("unknown type {}/{}", pl.zt_type, pl.zt_sub_type))?;
+    let mapview = unsafe { GET_MAPVIEW.original()() };
+    if mapview.is_null() {
+        return Err("no map view".into());
+    }
+    // `BFEntityType::create(this, flag)` (0x412669; openzt's table calls it `bfoverlaytype::CREATE`):
+    // `createEntity` (type vtable 0x5c) then the entity's `init(flag)` (entity vtable 0x108).
+    let entity = unsafe { BFENTITYTYPE_CREATE.original()(type_ptr as *const u32, false) } as u32;
+    if entity == 0 {
+        return Err("create returned null".into());
+    }
+    unsafe {
+        *((entity + 0x12c) as *mut i32) = pl.rotation;
+        SET_WORLD_POS.original()(entity as *const u32, pl.pos.as_ptr() as *const u32);
+        // `snapToGrid` fills the entity's screen position (+0xb4/+0xb8), which the buy cursor does
+        // while the player moves the building. Without it the entity is in the world but never drawn.
+        SNAP_TO_GRID.original()(entity as *const u32);
+    }
+    APPLYING_REMOTE.store(true, Ordering::Relaxed);
+    let placed = unsafe { PLACE_ENTITY_ON_MAP_1.hooked()(mapview, entity as *const u32, 0.0, 0) };
+    APPLYING_REMOTE.store(false, Ordering::Relaxed);
+    if placed.is_null() {
+        return Err(format!("placeEntityOnMap refused {}", fmt_placement(pl)));
+    }
+    Ok(placed as u32)
+}
